PORT=3000
HOST=127.0.0.1
# Run npm run setup:admin to create server-side admin credentials.
# Public HTTPS URL on cPanel (used for Secure cookies + origin checks behind proxy):
# TECHPRO_PUBLIC_URL=https://algorift.online
# Optional comma-separated extra hosts allowed for API Origin:
# TECHPRO_ALLOWED_ORIGINS=algorift.online,www.algorift.online
# Optional override: COOKIE_SECURE=1 (force Secure) or COOKIE_SECURE=0 (disable)

# MySQL (shared inventory + POS). Prefer DATABASE_URL on cPanel when available.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/techpro
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=techpro
MYSQL_PASSWORD=
MYSQL_DATABASE=techpro
# Aliases used in some cPanel guides:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=techpro
# DB_PASSWORD=
# DB_NAME=techpro
# MYSQL_POOL_SIZE=15
