PORT=3000
HOST=127.0.0.1
# Run npm run setup:admin to create server-side admin credentials.
# Set the public HTTPS URL on cPanel / TLS deployments so admin cookies use Secure:
# TECHPRO_PUBLIC_URL=https://store.example
# Optional override: COOKIE_SECURE=1

# MySQL (shared inventory + POS). Prefer DATABASE_URL on cPanel when available.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/techpro
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=techpro
MYSQL_PASSWORD=
MYSQL_DATABASE=techpro
# Aliases used in some cPanel guides:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=techpro
# DB_PASSWORD=
# DB_NAME=techpro
# MYSQL_POOL_SIZE=15
